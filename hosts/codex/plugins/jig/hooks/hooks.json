{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/scripts/jig-telemetry.sh",
            "timeout": 5,
            "statusMessage": "jig: record task telemetry"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/scripts/jig-skill-trace.sh",
            "timeout": 5,
            "statusMessage": "jig: record skill usage"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/scripts/jig-spec-gate.sh",
            "timeout": 5,
            "statusMessage": "jig: enforce spec gate"
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/scripts/jig-secret-scan.sh",
            "timeout": 5,
            "statusMessage": "jig: scan for secrets"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/scripts/jig-context-check.sh",
            "timeout": 5,
            "statusMessage": "jig: check context budget"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/scripts/jig-post-edit-verify.sh",
            "timeout": 5,
            "statusMessage": "jig: verify edit landed"
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/scripts/jig-boundary-change-warn.sh",
            "timeout": 5,
            "statusMessage": "jig: warn on boundary changes"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/scripts/jig-decision-inflight.sh",
            "timeout": 5,
            "statusMessage": "jig: decision inflight"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/scripts/jig-context-check.sh",
            "timeout": 5,
            "statusMessage": "jig: check context budget"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/scripts/jig-project-orient.sh",
            "timeout": 5,
            "statusMessage": "jig: orient project state"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/scripts/jig-semantic-index.sh",
            "timeout": 25,
            "statusMessage": "jig: semantic index"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/scripts/jig-memory-scan.sh",
            "timeout": 10,
            "statusMessage": "jig: scan memory references"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/scripts/jig-context-check.sh",
            "timeout": 5,
            "statusMessage": "jig: check context budget"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/scripts/jig-decision-inflight.sh",
            "timeout": 5,
            "statusMessage": "jig: decision inflight"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/scripts/jig-task-capture.sh",
            "timeout": 10,
            "statusMessage": "jig: capture follow-up tasks"
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/scripts/jig-decision-capture.sh",
            "timeout": 10,
            "statusMessage": "jig: decision capture"
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/scripts/jig-claim-check.sh",
            "timeout": 10,
            "statusMessage": "jig: verify spec/slice/ADR claims"
          }
        ]
      }
    ]
  }
}
